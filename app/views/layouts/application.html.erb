<!DOCTYPE html>
<% accent = UtilityBarComponent.resolve_accent(cookies[:accent]) %>
<html style="--accent: var(--accent-<%= accent[:key] %>)"<%= " data-startupbar" if startupbar_enabled? %>>
  <head>
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= social_meta_tags %>
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="XbutforY">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.ico" type="image/ico">
    <link rel="apple-touch-icon" href="/icon.ico">

    <%= auto_discovery_link_tag(:atom, feed_url, title: "XbutforY — Latest Submissions") %>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <% if startupbar_enabled? %>
      <script
        async
        src="https://startupbar.co/widget/loader.js"
        data-startup-id="<%= ApplicationHelper::STARTUPBAR_ID %>"
      ></script>
    <% end %>
    <% if umami_enabled? %>
      <script
        defer
        src="https://cloud.umami.is/script.js"
        data-website-id="<%= ENV["UMAMI_WEBSITE_ID"] %>"
      ></script>
    <% end %>
  </head>

  <%# The offset controller only has work to do when we asked for the widget;
      without it --startupbar-h stays 0 and the nav sits flush with the top. %>
  <body class="<%= content_for(:body_class) %>" <%= tag.attributes(data: { controller: ("startupbar-offset" if startupbar_enabled?) }) %>>
    <%= render "shared/umami_identify" %>
    <%# Server-set conversions (submitted a listing, completed a payment) get
        fired client-side once the page with the flash loads. %>
    <% if umami_enabled? && flash[:umami_event].present? %>
      <script>
        document.addEventListener('DOMContentLoaded', function() {
          if (typeof umami !== 'undefined') {
            umami.track('<%= j(flash[:umami_event]) %>', <%= raw (flash[:umami_data] || {}).to_json %>);
          }
        });
      </script>
    <% end %>
    <%= render UtilityBarComponent.new(active_accent: accent[:key], current_user: current_user) %>
    <%= render MastheadComponent.new do |masthead| %>
      <% masthead.with_search_slot do %>
        <%= render SearchInputComponent.new(value: params[:q].to_s) %>
      <% end %>
    <% end %>
    <%= render GlossyNavComponent.new(
      active: content_for(:nav_tab) || "latest",
      note: "#{number_with_delimiter(Entry.count)} sites indexed"
    ) %>

    <% if current_user && !current_user.confirmed? %>
      <div class="c-confirm-banner">
        <div class="c-confirm-banner__inner">
          <span>📨 Confirm your email (<%= current_user.email %>) to keep your account in good standing.</span>
          <%= button_to "Resend link", resend_confirmation_path, method: :post, class: "c-confirm-banner__action" %>
        </div>
      </div>
    <% end %>

    <main class="l-content">
      <%= yield %>

      <%= render FooterComponent.new %>
    </main>

    <%= render ToastComponent.new(message: flash[:notice]) %>

    <div data-controller="konami">
      <div class="c-konami__backdrop" data-konami-target="backdrop" data-action="click->konami#close" hidden></div>
      <canvas class="c-konami__canvas" data-konami-target="canvas" hidden></canvas>
      <div class="c-konami__modal" data-konami-target="modal" hidden>
        <button class="c-konami__close" data-action="click->konami#close" title="close">&times;</button>
        <div class="c-konami__label">🎆 KONAMI CODE ACCEPTED</div>
        <h2 class="c-konami__title">One free promotion, <em>unlocked</em>.</h2>
        <p class="c-konami__body">You clearly know your way around a keyboard. Here&rsquo;s a coupon for one <strong>Featured promotion</strong> &mdash; a homepage Spotlight slot ($1.99 value), on the house.</p>
        <div class="c-konami__code-label">YOUR COUPON CODE</div>
        <div class="c-konami__code-row">
          <div class="c-konami__code">XBUTFORY-K0N4M1</div>
          <button class="c-konami__copy" data-action="click->konami#copy" data-umami-event="Konami coupon copied">Copy</button>
        </div>
        <button class="c-konami__claim" data-action="click->konami#claim" data-umami-event="Konami coupon claimed">Claim it &mdash; submit a site &rarr;</button>
        <p class="c-konami__fine">redeemable on one submission &middot; expires never &middot; because you earned it</p>
      </div>
    </div>

    <% unless current_user %>
      <div
        class="c-auth-modal"
        data-controller="auth-modal"
        data-action="keydown@window->auth-modal#onKeydown"
        hidden
      >
        <div class="c-auth-modal__backdrop" data-action="click->auth-modal#close"></div>
        <div
          class="c-auth-modal__card"
          role="dialog"
          aria-modal="true"
          aria-labelledby="auth-modal-title"
          data-auth-modal-target="card"
        >
          <button class="c-auth-modal__close" data-action="click->auth-modal#close" title="close">&times;</button>
          <div class="c-auth-modal__label">HOLD ON &mdash;</div>
          <h2 class="c-auth-modal__title" id="auth-modal-title">You need an account to <em>vote</em>.</h2>
          <p class="c-auth-modal__body">Votes are the whole point of the ballot, so we tie them to a name. Sign in, or make an account &mdash; it takes a second.</p>
          <div class="c-auth-modal__actions">
            <%= link_to "Sign in", sign_in_path, class: "c-auth-modal__btn c-auth-modal__btn--solid", data: { umami_event: "Sign in clicked", umami_event_placement: "vote-gate" } %>
            <%= link_to "Create account", sign_up_path, class: "c-auth-modal__btn c-auth-modal__btn--ghost", data: { umami_event: "Create account clicked", umami_event_placement: "vote-gate" } %>
          </div>
        </div>
      </div>
    <% end %>
  </body>
</html>
